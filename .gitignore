# Lokalny runtime Node.js, logi i pliki kontrolne
/.local/

# Lokalna baza: galeria, projekty, wiadomości i hasło administratora
/data/
/backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm

# Zależności i cache narzędzi
node_modules/
.npm/
.cache/
coverage/
.nyc_output/

# Konfiguracja prywatna (szablon można dodać do repozytorium)
.env
.env.*
!.env.example

# Logi i pliki tymczasowe
*.log
*.pid
*.tmp
*.temp
*.bak
*~

# Tymczasowe strony używane podczas sprawdzania projektu
/.*-check.html
/gallery-browser-check.html
/gallery-browser-check.js

# Pliki systemowe
.DS_Store
Thumbs.db
Desktop.ini

# Publiczne eksporty w assets/js i zdjęcia w assets/images pozostają wersjonowane.

# Lokalne dokumenty robocze i podglądy
/outputs/
/work/
/output/

# Cache budowania, stan narzędzi i prywatne klucze
/dist/
/.agents/
/.codex/
*.tsbuildinfo
*.pem
*.key

# Wycofana lokalna integracja — nie dodawaj przypadkiem ponownie artefaktów.
/sites/
